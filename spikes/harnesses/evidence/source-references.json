        {
          "line": 633,
          "text": "def _get_disabled_plugins() -> set:"
        },
        {
          "line": 634,
          "text": "    \"\"\"Read the disabled plugins list from config.yaml."
        },
        {
          "line": 635,
          "text": ""
        },
        {
          "line": 636,
          "text": "    Kept for backward compat and explicit deny-list semantics. A plugin"
        },
        {
          "line": 637,
          "text": "    name in this set will never load, even if it appears in"
        },
        {
          "line": 638,
          "text": "    ``plugins.enabled``."
        },
        {
          "line": 639,
          "text": "    \"\"\""
        },
        {
          "line": 640,
          "text": "    try:"
        },
        {
          "line": 641,
          "text": "        from hermes_cli.config import load_config"
        },
        {
          "line": 642,
          "text": "        config = load_config()"
        },
        {
          "line": 643,
          "text": "        disabled = cfg_get(config, \"plugins\", \"disabled\", default=[])"
        },
        {
          "line": 644,
          "text": "        return set(disabled) if isinstance(disabled, list) else set()"
        },
        {
          "line": 645,
          "text": "    except Exception:"
        },
        {
          "line": 646,
          "text": "        return set()"
        },
        {
          "line": 647,
          "text": ""
        },
        {
          "line": 648,
          "text": ""
        },
        {
          "line": 649,
          "text": "def _get_enabled_plugins() -> Optional[set]:"
        },
        {
          "line": 650,
          "text": "    \"\"\"Read the enabled-plugins allow-list from config.yaml."
        },
        {
          "line": 651,
          "text": ""
        },
        {
          "line": 652,
          "text": "    Plugins are opt-in by default \u2014 only plugins whose name appears in"
        },
        {
          "line": 653,
          "text": "    this set are loaded. Returns:"
        },
        {
          "line": 654,
          "text": ""
        },
        {
          "line": 655,
          "text": "    * ``None`` \u2014 the key is missing or malformed. Callers should treat"
        },
        {
          "line": 656,
          "text": "      this as \"nothing enabled yet\" (the opt-in default); the first"
        },
        {
          "line": 657,
          "text": "      ``migrate_config`` run populates the key with a grandfathered set"
        },
        {
          "line": 658,
          "text": "      of currently-installed user plugins so existing setups don't"
        },
        {
          "line": 659,
          "text": "      break on upgrade."
        },
        {
          "line": 660,
          "text": "    * ``set()`` \u2014 an empty list was explicitly set; nothing loads."
        },
        {
          "line": 661,
          "text": "    * ``set(...)`` \u2014 the concrete allow-list."
        },
        {
          "line": 662,
          "text": "    \"\"\""
        },
        {
          "line": 663,
          "text": "    try:"
        },
        {
          "line": 664,
          "text": "        from hermes_cli.config import load_config"
        },
        {
          "line": 665,
          "text": "        config = load_config()"
        },
        {
          "line": 666,
          "text": "        plugins_cfg = config.get(\"plugins\")"
        },
        {
          "line": 667,
          "text": "        if not isinstance(plugins_cfg, dict):"
        },
        {
          "line": 668,
          "text": "            return None"
        },
        {
          "line": 669,
          "text": "        if \"enabled\" not in plugins_cfg:"
        },
        {
          "line": 670,
          "text": "            return None"
        },
        {
          "line": 671,
          "text": "        enabled = plugins_cfg.get(\"enabled\")"
        },
        {
          "line": 672,
          "text": "        if not isinstance(enabled, list):"
        },
        {
          "line": 673,
          "text": "            return None"
        },
        {
          "line": 674,
          "text": "        return set(enabled)"
        }
      ]
