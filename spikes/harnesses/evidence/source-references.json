      "excerpts": [
        {
          "line": 108,
          "text": "def _fire_approval_hook(hook_name: str, **kwargs) -> None:"
        },
        {
          "line": 109,
          "text": "    \"\"\"Invoke a plugin lifecycle hook for the approval system."
        },
        {
          "line": 110,
          "text": ""
        },
        {
          "line": 111,
          "text": "    Lazy-imports the plugin manager to avoid circular imports (approval.py is"
        },
        {
          "line": 112,
          "text": "    imported very early, long before plugins are discovered). Never raises --"
        },
        {
          "line": 113,
          "text": "    plugin errors are logged and swallowed."
        },
        {
          "line": 114,
          "text": ""
        },
        {
          "line": 115,
          "text": "    Only fires for the two approval-specific hooks in VALID_HOOKS:"
        },
        {
          "line": 116,
          "text": "    pre_approval_request, post_approval_response."
        },
        {
          "line": 117,
          "text": "    \"\"\""
        },
        {
          "line": 118,
          "text": "    try:"
        },
        {
          "line": 119,
          "text": "        from hermes_cli.lifecycle import invoke_hook"
        },
        {
          "line": 120,
          "text": "    except Exception:"
        },
        {
          "line": 121,
          "text": "        # Plugin system not available in this execution context"
        },
        {
          "line": 122,
          "text": "        # (e.g. bare tool-only imports, minimal test environments)."
        },
        {
          "line": 123,
          "text": "        return"
        },
        {
          "line": 124,
          "text": "    try:"
        },
        {
          "line": 125,
          "text": "        kwargs.setdefault(\"turn_id\", _approval_turn_id.get())"
        },
        {
          "line": 126,
          "text": "        kwargs.setdefault(\"tool_call_id\", _approval_tool_call_id.get())"
        },
        {
          "line": 127,
          "text": "        # Forward the Hermes session id so observer plugins parent approval"
        },
        {
          "line": 128,
          "text": "        # marks to the real session scope instead of a synthetic \"default\""
        },
        {
          "line": 129,
          "text": "        # session (whose scope never closes \u2192 marks never export)."
        },
        {
          "line": 130,
          "text": "        _session_id = _approval_session_id.get()"
        },
        {
          "line": 131,
          "text": "        if _session_id:"
        },
        {
          "line": 132,
          "text": "            kwargs.setdefault(\"session_id\", _session_id)"
        },
        {
          "line": 133,
          "text": "        invoke_hook(hook_name, **kwargs)"
        },
        {
          "line": 134,
          "text": "    except Exception as exc:"
        },
        {
          "line": 135,
          "text": "        # invoke_hook() already swallows per-callback errors, so reaching here"
        },
        {
          "line": 136,
          "text": "        # means the dispatch layer itself failed. Log and move on -- approval"
        },
        {
          "line": 137,
          "text": "        # flow is safety-critical, plugin observability is not."
        },
        {
          "line": 138,
          "text": "        logger.debug(\"Approval hook %s dispatch failed: %s\", hook_name, exc)"
        }
      ]
    },
